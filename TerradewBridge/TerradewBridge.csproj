<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build: set TMOD_PATH to your tModLoader install if it is not in the default Steam folder.
    macOS default: ~/Library/Application Support/Steam/steamapps/common/tModLoader
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TerradewBridge</RootNamespace>
    <AssemblyName>TerradewBridge</AssemblyName>
    <BuildMod>false</BuildMod>
    <LangVersion>12.0</LangVersion>
    <TModPath Condition="'$(TModPath)' == '' and '$(TMOD_PATH)' != ''">$(TMOD_PATH)</TModPath>
    <TModPath Condition="'$(TModPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/tModLoader</TModPath>
    <TModPath Condition="'$(TModPath)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.local/share/Steam/steamapps/common/tModLoader</TModPath>
    <TModPath Condition="'$(TModPath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files (x86)\Steam\steamapps\common\tModLoader</TModPath>
  </PropertyGroup>

  <Import Project="$(TModPath)/tMLMod.targets" Condition="Exists('$(TModPath)/tMLMod.targets')" />

  <!--
    Core is a symlink to ../Terradew.Core. tModLoader's in-game builder compiles every .cs file under the mod
    folder and ignores Compile items here, so the shared code has to live inside the folder.
  -->
  <ItemGroup>
    <Compile Remove="Core/bin/**;Core/obj/**;Core/*.csproj" />
  </ItemGroup>
</Project>
