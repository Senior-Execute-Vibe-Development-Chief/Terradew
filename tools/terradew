#!/usr/bin/env bash
# Dev launcher for Terradew on macOS: starts and stops Stardew Valley (with SMAPI) and tModLoader through Steam.
#
#   tools/terradew start      start tModLoader, then Stardew
#   tools/terradew stop       close both games
#   tools/terradew restart    stop, rebuild the Stardew mod, start again
#   tools/terradew status     which games are running, and whether the bridge is connected
#   tools/terradew logs       follow the SMAPI and tModLoader logs
#   tools/terradew build      build the Stardew mod (it deploys itself into Mods)
#
# Optional settings (environment variables):
#   TERRADEW_PLAYER   tModLoader character name. With it set, tModLoader skips the menus and loads
#                     that character straight into the world "Stardew Valley" (uses -skipselect).
#   TERRADEW_WORLD    world name for -skipselect (default: Stardew Valley)
#   TERRADEW_WAIT     seconds to wait for Terraria before starting Stardew (default: 20)
set -euo pipefail

STARDEW_APP=413150
TMOD_APP=1281930
PORT=47821
WORLD="${TERRADEW_WORLD:-Stardew Valley}"
WAIT="${TERRADEW_WAIT:-20}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SMAPI_LOG="$HOME/.config/StardewValley/ErrorLogs/SMAPI-latest.txt"
# tModLoader 1.4 writes its logs next to the install, not in the save folder.
TMOD_LOG="$HOME/Library/Application Support/Steam/steamapps/common/tModLoader/tModLoader-Logs/client.log"

# Process patterns: SMAPI runs as StardewModdingAPI; tModLoader runs as dotnet tModLoader.dll.
STARDEW_MATCH='StardewModdingAPI|Stardew Valley.app/Contents/MacOS/StardewValley'
TMOD_MATCH='tModLoader\.dll'

say() { printf '\033[1;32m›\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }

running() { pgrep -if "$1" >/dev/null 2>&1; }

bridge_up() { lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; }

steam_run() {
  local app="$1" args="${2:-}"
  if [[ -n "$args" ]]; then
    # steam://run/<app>//<args>/ passes launch arguments; spaces must be URL-encoded.
    open "steam://run/$app//$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$args")/"
  else
    open "steam://run/$app"
  fi
}

start_tmod() {
  if running "$TMOD_MATCH"; then
    say "tModLoader is already running."
    return
  fi
  if [[ -n "${TERRADEW_PLAYER:-}" ]]; then
    say "Starting tModLoader as $TERRADEW_PLAYER in \"$WORLD\"..."
    steam_run "$TMOD_APP" "-skipselect \"$TERRADEW_PLAYER:$WORLD\""
  else
    say "Starting tModLoader. Pick your character and the world \"$WORLD\"."
    steam_run "$TMOD_APP"
  fi
}

start_stardew() {
  if running "$STARDEW_MATCH"; then
    say "Stardew Valley is already running."
    return
  fi
  say "Starting Stardew Valley (SMAPI must be set as its Steam launcher)..."
  steam_run "$STARDEW_APP"
}

wait_for_bridge() {
  say "Waiting up to ${WAIT}s for the Terraria bridge on port ${PORT}..."
  for ((i = 0; i < WAIT; i++)); do
    if bridge_up; then
      say "Bridge is listening."
      return
    fi
    sleep 1
  done
  warn "No bridge yet. Stardew will keep retrying once you are in the world \"$WORLD\"."
}

stop_one() {
  local name="$1" match="$2"
  if ! running "$match"; then
    say "$name is not running."
    return
  fi
  say "Closing ${name}..."
  pkill -TERM -if "$match" || true
  for _ in {1..10}; do
    running "$match" || { say "$name closed."; return; }
    sleep 1
  done
  warn "$name did not close; forcing it."
  pkill -KILL -if "$match" || true
}

status() {
  running "$TMOD_MATCH" && say "tModLoader: running" || say "tModLoader: stopped"
  running "$STARDEW_MATCH" && say "Stardew Valley: running" || say "Stardew Valley: stopped"
  bridge_up && say "Bridge: listening on $PORT" || say "Bridge: not listening (Terraria not in the world \"$WORLD\")"
  if lsof -nP -iTCP:"$PORT" -sTCP:ESTABLISHED >/dev/null 2>&1; then
    say "Link: Stardew is connected"
  fi
}

build() {
  say "Building the Stardew mod..."
  dotnet build "$ROOT/Terradew/Terradew.csproj" -c Debug
  say "Rebuild Terradew Bridge inside tModLoader: Workshop → Develop Mods → Build."
}

logs() {
  local files=()
  [[ -f "$SMAPI_LOG" ]] && files+=("$SMAPI_LOG")
  [[ -f "$TMOD_LOG" ]] && files+=("$TMOD_LOG")
  if ((${#files[@]} == 0)); then
    warn "No logs yet. Start the games first."
    exit 1
  fi
  tail -n 40 -F "${files[@]}"
}

case "${1:-}" in
  start)
    start_tmod
    wait_for_bridge
    start_stardew
    ;;
  stop)
    stop_one "Stardew Valley" "$STARDEW_MATCH"
    stop_one "tModLoader" "$TMOD_MATCH"
    ;;
  restart)
    stop_one "Stardew Valley" "$STARDEW_MATCH"
    stop_one "tModLoader" "$TMOD_MATCH"
    build
    start_tmod
    wait_for_bridge
    start_stardew
    ;;
  status) status ;;
  logs) logs ;;
  build) build ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
