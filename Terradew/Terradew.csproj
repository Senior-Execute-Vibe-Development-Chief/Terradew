<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build with `dotnet build`. Pathoschild.Stardew.ModBuildConfig finds a standard Steam or GOG install by itself;
    set GamePath (or the STARDEW_PATH environment variable) only if Stardew Valley lives somewhere else.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Terradew</RootNamespace>
    <AssemblyName>Terradew</AssemblyName>
    <EnableModDeploy>true</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <EnableHarmony>true</EnableHarmony>
    <GamePath Condition="'$(GamePath)' == '' and '$(STARDEW_PATH)' != ''">$(STARDEW_PATH)</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Terradew.Core\**\*.cs" Exclude="..\Terradew.Core\bin\**;..\Terradew.Core\obj\**" LinkBase="Core" />
  </ItemGroup>
</Project>
